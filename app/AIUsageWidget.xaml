<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Background="#0B0C0E" BorderBrush="#33363B" BorderThickness="1"
        TextOptions.TextFormattingMode="Display">
    <Border.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F0F1F3" />
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#191B20" />
            <Setter Property="Foreground" Value="#F0F1F3" />
            <Setter Property="BorderBrush" Value="#383C43" />
        </Style>
        <Style x:Key="ToolbarButton" TargetType="ButtonBase">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="27" />
            <Setter Property="Foreground" Value="#B5BAC3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#252830" />
                                <Setter Property="Foreground" Value="#F0F1F3" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#A7B0BF" />
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#272B33" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#4B535F" />
                                <Setter Property="Foreground" Value="#D9DEE7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#777D86" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProviderHeader" TargetType="ToggleButton">
            <Setter Property="Padding" Value="11,5,12,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderThickness="1"
                                BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <Path x:Name="Chevron" Width="9" Height="9" DockPanel.Dock="Left"
                                      Data="M2.5,1.5 L5.5,4.5 L2.5,7.5"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.25" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center" Margin="0,0,7,0" />
                                <ContentPresenter />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#191B20" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#A7B0BF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="Data" Value="M1.5,3 L4.5,6 L7.5,3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <LinearGradientBrush x:Key="AntigravityQuotaBrush" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#79A9FF" Offset="0" />
            <GradientStop Color="#8FBAF6" Offset="0.38" />
            <GradientStop Color="#85CDA8" Offset="0.63" />
            <GradientStop Color="#E7C278" Offset="0.84" />
            <GradientStop Color="#E89C96" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="QuotaBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Background" Value="#272A31" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="2" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollTrackButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuotaScrollbar" TargetType="ScrollBar">
            <Setter Property="Width" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="#101114" Padding="2">
                            <Track x:Name="PART_Track" IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollTrackButton}"
                                                  Command="{x:Static ScrollBar.PageUpCommand}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Handle" Background="#454B55" CornerRadius="3" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Handle" Property="Background" Value="#67707D" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollTrackButton}"
                                                  Command="{x:Static ScrollBar.PageDownCommand}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WidgetMenu" TargetType="ContextMenu">
            <Setter Property="Foreground" Value="#F0F1F3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#15171B" BorderBrush="#383C43" BorderThickness="1" CornerRadius="6" Padding="4">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="MenuItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="MenuItem">
                                    <Border x:Name="Surface" Background="Transparent" CornerRadius="3" Padding="8,6">
                                        <DockPanel>
                                            <Path x:Name="Check" DockPanel.Dock="Left" Width="12" Margin="0,0,7,0"
                                                  Data="M1,5 L4,8 L10,2" Stroke="#D9DEE7" StrokeThickness="1.5"
                                                  VerticalAlignment="Center" Visibility="Hidden" />
                                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Surface" Property="Background" Value="#252830" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Border.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border BorderBrush="#272A30" BorderThickness="0,0,0,1" Padding="11,6,7,6">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#202126" Offset="0" />
                    <GradientStop Color="#15161A" Offset="0.85" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="DragArea" Background="Transparent" ToolTip="Drag to move">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="HeaderIcon" Width="25" Height="25" Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="AI Usage Widget" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="RefreshButton" Style="{StaticResource ToolbarButton}"
                            ToolTip="Refresh quota" AutomationProperties.Name="Refresh quota">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" Data="M13,5 A6,6 0 1 0 13,11 M13,1 L13,5 L9,5" />
                    </Button>
                    <ToggleButton x:Name="PinButton" Style="{StaticResource ToolbarButton}"
                                  AutomationProperties.Name="Keep on top">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M8,1 L14,7 L12,7 L8.8,10.2 L8.8,13 L1.8,6 L4.6,6 L8,2.6 Z M5.3,9.5 L1,13.8" />
                    </ToggleButton>
                    <Button x:Name="MinimizeButton" Style="{StaticResource ToolbarButton}" ToolTip="Minimize to taskbar"
                            AutomationProperties.Name="Minimize to taskbar">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M1,1 H12" />
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource ToolbarButton}" ToolTip="Settings"
                            AutomationProperties.Name="Widget settings">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.3" StrokeLineJoin="Round"
                              Data="M6,1 H9 L9.5,3 L11.2,4 L13,3.5 L14.5,6 L13,7.5 V9 L14.5,10.5 L13,13 L11.2,12.5 L9.5,13.5 L9,15.5 H6 L5.5,13.5 L3.8,12.5 L2,13 L0.5,10.5 L2,9 V7.5 L0.5,6 L2,3.5 L3.8,4 L5.5,3 Z M9.7,8.25 A2.2,2.2 0 1 0 5.3,8.25 A2.2,2.2 0 1 0 9.7,8.25" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource ToolbarButton}" ToolTip="Close"
                            AutomationProperties.Name="Close widget">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M1,1 L11,11 M11,1 L1,11" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer x:Name="QuotaScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource QuotaScrollbar}" />
            </ScrollViewer.Resources>
            <StackPanel x:Name="Cards" />
        </ScrollViewer>
        <Border Grid.Row="2" Background="#15161A" BorderBrush="#272A30" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0,0,0" LastChildFill="True">
                <Border DockPanel.Dock="Right" Width="24" Height="24" Background="Transparent"
                        shell:WindowChrome.ResizeGripDirection="BottomRight">
                    <Path Stroke="#777F8A" StrokeThickness="1.15" Data="M1,9 L9,1 M5,9 L9,5 M9,9 L9.5,8.5"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4"
                          IsHitTestVisible="False" />
                </Border>
                <TextBlock x:Name="Status" VerticalAlignment="Center" FontSize="10" Foreground="#A0A6B0"
                           TextTrimming="CharacterEllipsis" ToolTip="Checks every 3 minutes, when a quota window resets, or when you refresh (F5)." />
            </DockPanel>
        </Border>
    </Grid>
</Border>
